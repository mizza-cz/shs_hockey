<div
  class="modal fade"
  id="modalProduct"
  tabindex="-1"
  aria-labelledby="productModalLabel"
  aria-hidden="true"
>
  <div class="modal-dialog modal-dialog-centered productModal">
    <div class="modal-content">
      <div class="modal-header p-6">
        <button type="button" class="btn-close" data-bs-dismiss="modal">
          {% include "@images/x-close.svg" %}
        </button>
      </div>

      <div class="modal-body px-md-8 px-4">
        <div class="programDetail">
          <div class="productModal__img">
            <img
              src="images/content/product-1.png"
              loading="lazy"
              alt="program"
            />
          </div>
          <h2 class="h3 mb-6">Bílý zápasový dres SHS selection</h2>
          <div class="mb-6" style="max-width: 320px">
            <select class="js-select" name="size" required>
              <option value="">Velikost</option>
              <option value="S" selected>S</option>
              <option value="M">M</option>
              <option value="L">L</option>
              <option value="XXl">XXl</option>
            </select>
          </div>
          <div class="o-content">
            <p>
              Kvalitní, pevný dres pro tréninky. Základní střih. Límec ve tvaru
              „V“ bez tkaničky. Materiál Milano 210 g/m². Možnost vyrobení dresu
              i pro brankáře.
            </p>
            <ul>
              <li>kvalitní, pevný dres pro tréninky i utkání</li>
              <li>základní střih s rovným sedlem</li>
              <li>límec ve tvaru „V“ s tkaničkou</li>
              <li>materiál Milano 210 g/m²</li>
              <li>velikosti: XS, S, M, L, XL, XXL</li>
              <li>možnost vyrobení dresu i pro brankáře</li>
            </ul>
          </div>
          <div class="row align-items-center border-top-1 pt-6 mt-6">
            <div class="col-12 col-md-8 mb-4">
              <ul class="programDetail__info">
                <li>
                  <div class="programDetail__info-item">
                    <img
                      src="images/ico/price.svg"
                      loading="lazy"
                      alt="termin"
                    />
                    Cena:
                  </div>
                  <p>700 Kč</p>
                </li>
              </ul>
            </div>
            <div class="col-12 col-md-4 mb-4 text-center text-md-end">
              <a
                class="button-primary"
                data-toggle="collapse"
                href="#vstupenky"
                role="button"
                aria-expanded="false"
                aria-controls="vstupenky"
                >Objednat</a
              >
            </div>
          </div>
        </div>
      </div>

      <div class="modal-footer">
        <div class="d-flex gap-3 w-100 justify-content-center">
          <button class="button-secondary button-lg" data-bs-dismiss="modal">
            Zavřít
          </button>
        </div>
      </div>
    </div>
  </div>
</div>
