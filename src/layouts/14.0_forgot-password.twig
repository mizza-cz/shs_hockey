{% extends "@components/base/base.twig" %} {% set title = "14.0_forgot-password"
%} {% block main %}

<section class="auth-section pt-8 mb-xxl-30 mb-lg-20 mb-15">
  <div class="container">
    <div class="mb-6 text-center">
      <h1 class="h2 mb-3">Zapomenuté heslo</h1>
    </div>

    <div class="auth-content">
      <form class="auth-form" action="/register" method="POST">
        <div class="mb-5">
          <label for="email" class="form-label">
            E-mail <span class="required">*</span>
          </label>
          <input
            id="email"
            name="email"
            type="email"
            class="form-control"
            placeholder="Zadejte e-mail"
            required
          />
        </div>

        <button type="submit" class="button-primary button-lg w-100">
          Odeslat
        </button>
      </form>
    </div>
  </div>
</section>

{% include "@components/footer-projects/footer-projects.twig" %} {% endblock %}
