{% extends "@components/base/base.twig" %} {% set title = "15.0_team" %} {%
block main %}

<section class="coaches-section pt-xl-16 pt-12">
  <div class="container">
    <h1 class="h1 text-center mb-lg-8 mb-6">Hráči</h1>
    <h3 class="h3 text-center mb-lg-8 mb-6">Záložníci</h3>
    <div class="row g-lg-8 g-6 mb-xxl-30 mb-lg-20 mb-15">
      {% for i in 1..6 %}
      <div class="col-lg-4 col-sm-6">
        <a href="#" class="playersSlider-item">
          <img src="images/content/player-1.png" loading="lazy" alt="player" />
          <div class="badge-sm bg-gray-700 text-md">David Pastrňák</div>
        </a>
      </div>
      {% endfor %}
    </div>
    <h3 class="h3 text-center mb-lg-8 mb-6">Obránci</h3>
    <div class="row g-lg-8 g-6 mb-xxl-30 mb-lg-20 mb-15">
      {% for i in 1..3 %}
      <div class="col-lg-4 col-sm-6">
        <a href="#" class="playersSlider-item">
          <img src="images/content/player-2.png" loading="lazy" alt="player" />
          <div class="badge-sm bg-gray-700 text-md">Pavel Zacha</div>
        </a>
      </div>
      {% endfor %}
    </div>
    <h3 class="h3 text-center mb-lg-8 mb-6">Brankáři</h3>
    <div class="row g-lg-8 g-6 mb-xxl-30 mb-lg-20 mb-15">
      {% for i in 1..3 %}
      <div class="col-lg-4 col-sm-6">
        <a href="#" class="playersSlider-item">
          <img src="images/content/player-4.png" loading="lazy" alt="player" />
          <div class="badge-sm bg-gray-700 text-md">Dominik Kubalík</div>
        </a>
      </div>
      {% endfor %}
    </div>
  </div>
</section>

{% include "@components/footer-projects/footer-projects.twig" %} {% endblock %}
